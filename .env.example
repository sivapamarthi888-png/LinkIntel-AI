# LinkIntel AI Environment Variables

# Backend
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Gemini AI (Optional - App works in demo mode without this)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
# Optional fallback model(s), comma-separated, tried in order if the primary fails
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite

# Database
DATABASE_PATH=./data/linkintel.db
